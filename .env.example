# Google Gemini API Keys (get from https://aistudio.google.com)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Tavily Search API Key (get from https://tavily.com)
TAVILY_API_KEY=

# Groq API Keys (get from https://console.groq.com)
GROQ_API_KEY_1=

# Supabase Credentials (get from https://app.supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_KEY=

# -- Blog Run Schedule ------------------------------------------
# Format: HH:MM in 24-hour IST time
# Add as many as you want — just keep numbering (no limit)
# 09:00 = 9 AM  |  14:00 = 2 PM  |  18:00 = 6 PM  |  21:00 = 9 PM
RUN_TIME_1=09:00
RUN_TIME_2=14:00
RUN_TIME_3=18:00
